{
  "name": "repro",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build && node scripts/generate-capabilities.mjs",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test:e2e-fixture": "pnpm --filter @jitterbox/repro-e2e-fixture test:e2e",
    "test:agent-e2e": "pnpm --filter @jitterbox/repro-agent-e2e test",
    "shoplite:dev": "pnpm --filter @jitterbox/repro-shoplite dev",
    "test:public-workflow": "node scripts/e2e/public-workflow.mjs",
    "test:capture-timing": "node scripts/e2e/capture-timing.mjs",
    "test:hidpi": "node scripts/e2e/hidpi.mjs",
    "test:interaction-diagnostics": "node scripts/e2e/interaction-diagnostics.mjs",
    "test:moving-privacy": "node scripts/e2e/moving-privacy.mjs",
    "test:checkpoint-checks": "node scripts/e2e/checkpoint-checks.mjs",
    "test:synchronization": "node scripts/e2e/synchronization.mjs",
    "test:review": "node scripts/e2e/review.mjs",
    "test:clean-install": "node scripts/e2e/clean-install.mjs",
    "test:browser-diagnostics": "node scripts/e2e/browser-diagnostics.mjs",
    "test:transient": "node scripts/e2e/transient.mjs",
    "test:recipes": "node scripts/e2e/recipes.mjs",
    "test:har-privacy": "node scripts/e2e/har-privacy.mjs",
    "test:milestone": "node scripts/e2e/milestone.mjs",
    "test:observations": "node scripts/e2e/observations.mjs",
    "test:watch-server": "node scripts/e2e/watch-server.mjs",
    "test:export-cache": "node scripts/e2e/export-cache.mjs",
    "test:annotation-benchmark": "node scripts/e2e/annotation-benchmark.mjs",
    "test:delivery": "node scripts/e2e/delivery.mjs",
    "release:pack": "node scripts/release.mjs",
    "test:discovery": "node scripts/e2e/discovery.mjs",
    "test:fresh-agent-replay": "node scripts/e2e/fresh-agent/replay.mjs",
    "test:strategy-matrix": "node scripts/e2e/strategy-matrix.mjs",
    "review:matrix": "node scripts/e2e/review-matrix-server.mjs",
    "test:overlay-matrix": "node scripts/e2e/overlay-matrix.mjs",
    "test:voiceover-matrix": "node scripts/e2e/voiceover-matrix.mjs",
    "test:review-matrix": "pnpm test:strategy-matrix && pnpm test:overlay-matrix && pnpm test:voiceover-matrix && node scripts/e2e/verify-review-matrix.mjs",
    "test:scene-polish": "node scripts/e2e/scene-polish.mjs",
    "test:bug-corpus": "node scripts/e2e/bug-corpus.mjs",
    "test:bug-corpus-review": "node scripts/e2e/bug-corpus-review.mjs",
    "test:web-dash-demos": "node scripts/e2e/web-dash-demos.mjs",
    "docs:generate": "node scripts/generate-reference.mjs",
    "docs:check": "node scripts/generate-reference.mjs --check",
    "release:prepare": "pnpm build && pnpm docs:check && node scripts/prepare-package.mjs",
    "release:check": "node scripts/check-release.mjs",
    "test:audit-retry": "node scripts/e2e/audit-retry.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "node-gyp": "^13.0.1",
    "opentype.js": "^2.0.0",
    "playwright": "1.62.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2",
    "zod": "4.4.3"
  },
  "version": "0.3.2",
  "license": "Apache-2.0"
}
