{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repro.dev/schemas/annotation.v2.schema.json",
  "title": "ReproAnnotationV2",
  "description": "Additive superset of annotation.schema.json. Every v1 property is retained; all v2 properties are optional so the planner can emit both bounds and anchor for one release.",
  "type": "object",
  "required": [
    "id",
    "component",
    "severity"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "component": {
      "type": "string",
      "description": "Names a part of the overlay kit; drives style selection and the quality gate.",
      "enum": [
        "target-ring",
        "leader",
        "plate",
        "callout",
        "step-badge",
        "progress-rail",
        "chapter",
        "console-toast",
        "pause-badge",
        "speed-chip",
        "click-ripple",
        "cursor-path",
        "keystroke-pill",
        "layout-shift-pair",
        "hit-target-guide",
        "hidden-ghost",
        "stacking-labels",
        "roi-magnifier",
        "freeze-banner",
        "vitals-hud",
        "redaction",
        "outcome-pair",
        "slate",
        "delta-caption"
      ]
    },
    "kind": {
      "type": "string",
      "description": "v1 field, retained",
      "enum": [
        "callout",
        "highlight",
        "cursor",
        "keystroke",
        "console",
        "step",
        "chapter",
        "redaction",
        "diff",
        "freeze",
        "spec"
      ]
    },
    "feature": {
      "type": "string",
      "description": "The config feature flag that emitted this annotation."
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "warn",
        "high",
        "critical"
      ]
    },
    "beatId": {
      "type": "string",
      "description": "Beat this annotation belongs to. Timing is inherited from the beat unless outTimeRange is set."
    },
    "outTimeRange": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "description": "OUTPUT-time ms. Produced only by mapTime(); never raw capture time.",
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "timeRange": {
      "type": "object",
      "description": "v1 capture-time range, retained for migration.",
      "properties": {
        "startMono": {
          "type": "number"
        },
        "endMono": {
          "type": "number"
        }
      }
    },
    "anchor": {
      "type": "object",
      "description": "Replaces bare bounds. A plate is positioned relative to this, never absolutely.",
      "properties": {
        "selector": {
          "type": "string"
        },
        "pageId": {
          "type": "string"
        },
        "bbox": {
          "type": "object",
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "w": {
              "type": "number"
            },
            "h": {
              "type": "number"
            }
          }
        },
        "track": {
          "type": "string",
          "enum": [
            "static",
            "sticky",
            "path"
          ],
          "default": "static",
          "description": "sticky requires per-frame geometry; degrade to static and lower confidence when unavailable."
        },
        "pad": {
          "type": "number",
          "default": 6
        },
        "evidenceRef": {
          "type": "string"
        }
      }
    },
    "placement": {
      "type": "object",
      "properties": {
        "prefer": {
          "type": "string",
          "enum": [
            "auto",
            "top",
            "bottom",
            "left",
            "right",
            "center"
          ],
          "default": "auto"
        },
        "slot": {
          "type": "string",
          "enum": [
            "auto",
            "tl",
            "tr",
            "bl",
            "br",
            "bottom-band",
            "top-band"
          ],
          "default": "auto"
        },
        "leader": {
          "type": "string",
          "enum": [
            "never",
            "ifDisplaced",
            "always"
          ],
          "default": "ifDisplaced"
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collisionPolicy": {
          "type": "string",
          "enum": [
            "avoid",
            "overlap",
            "truncate"
          ],
          "default": "avoid"
        }
      }
    },
    "plate": {
      "type": "object",
      "properties": {
        "kicker": {
          "type": "string",
          "maxLength": 32
        },
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "measurement": {
          "type": "string",
          "description": "Rendered tabular; e.g. \"Δx +12.0px\" or \"1,840ms\"."
        },
        "maxChars": {
          "type": "integer",
          "default": 42
        }
      }
    },
    "shape": {
      "type": "string",
      "enum": [
        "rect",
        "ellipse",
        "underline",
        "arrow",
        "line",
        "badge",
        "none"
      ]
    },
    "lineStyle": {
      "type": "string",
      "enum": [
        "solid",
        "dashed",
        "dotted"
      ],
      "description": "dashed is reserved for \"not present / not real\"; dotted for low confidence."
    },
    "motion": {
      "type": "object",
      "properties": {
        "in": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "ms": {
              "type": "integer"
            }
          }
        },
        "out": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "ms": {
              "type": "integer"
            }
          }
        }
      }
    },
    "renderer": {
      "type": "string",
      "enum": [
        "ass",
        "compositor"
      ],
      "default": "ass",
      "description": "Routing rule: moves or changes on most frames of its span -> ass. Still card that appears, holds, leaves -> compositor."
    },
    "priority": {
      "type": "number"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reviewState": {
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "dismissed",
        "verified"
      ]
    },
    "icon": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "description": "v1 field, retained"
    },
    "bounds": {
      "type": "object",
      "description": "v1 field, retained"
    }
  }
}
