{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "pass": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "skipped",
        "unsupported"
      ]
    },
    "message": {
      "type": "string"
    },
    "details": {}
  },
  "required": [
    "name",
    "pass",
    "status",
    "message"
  ],
  "additionalProperties": false
}
