{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "expected": {
      "default": "",
      "type": "string"
    },
    "actual": {
      "default": "",
      "type": "string"
    },
    "steps": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "const": "ticket-context"
          },
          "restricted": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "id",
          "name",
          "mediaType",
          "path",
          "sha256",
          "source",
          "provenance",
          "restricted"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "type": "string",
          "const": "jira"
        }
      },
      "required": [
        "source",
        "sha256",
        "kind"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "title"
  ],
  "additionalProperties": false
}
