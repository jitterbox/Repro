{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "repro",
        "compare",
        "demo"
      ]
    },
    "workItem": {
      "description": "Deprecated: older run snapshots only; supply issue identity per scenario/run",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "naming": {
      "type": "object",
      "properties": {
        "useWorkItemId": {
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "versionOverlay": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "discover": {
          "default": true,
          "type": "boolean"
        },
        "versionSelector": {
          "type": "string",
          "minLength": 1
        },
        "buildSelector": {
          "type": "string",
          "minLength": 1
        },
        "versionPath": {
          "type": "string",
          "pattern": "^[A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)*$"
        },
        "buildPath": {
          "type": "string",
          "pattern": "^[A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)*$"
        }
      },
      "additionalProperties": false
    },
    "export": {
      "type": "object",
      "properties": {
        "devtools": {
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "features": {
      "default": {},
      "type": "object",
      "properties": {
        "cursor": {
          "type": "boolean"
        },
        "keystrokes": {
          "type": "boolean"
        },
        "clickViz": {
          "type": "boolean"
        },
        "consoleOverlay": {
          "type": "boolean"
        },
        "specCard": {
          "type": "boolean"
        },
        "steps": {
          "type": "boolean"
        },
        "pauses": {
          "type": "boolean"
        },
        "slowmo": {
          "type": "boolean"
        },
        "zoom": {
          "type": "boolean"
        },
        "redaction": {
          "type": "boolean"
        },
        "vitalsHud": {
          "type": "boolean"
        },
        "voiceover": {
          "type": "boolean"
        },
        "freezeDetect": {
          "type": "boolean"
        },
        "a11yOverlay": {
          "type": "boolean"
        },
        "hiddenElements": {
          "type": "boolean"
        },
        "hitTargets": {
          "type": "boolean"
        },
        "stackingContexts": {
          "type": "boolean"
        },
        "layoutShiftViz": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "string",
      "enum": [
        "faithful",
        "controlled"
      ]
    },
    "surfaceCapture": {
      "type": "string",
      "enum": [
        "page",
        "os"
      ]
    },
    "timingSensitive": {
      "type": "boolean"
    },
    "preserveRealTiming": {
      "type": "boolean"
    },
    "showActions": {
      "type": "boolean"
    },
    "capturePreviewUi": {
      "type": "boolean"
    },
    "capture": {
      "type": "object",
      "properties": {
        "backend": {
          "default": "cdp",
          "type": "string",
          "enum": [
            "cdp",
            "native"
          ]
        },
        "date": {
          "default": 1704067200000,
          "type": "number"
        },
        "seed": {
          "default": 1,
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "locale": {
          "default": "en-US",
          "type": "string"
        },
        "timezone": {
          "default": "UTC",
          "type": "string"
        },
        "serviceWorkers": {
          "default": "block",
          "type": "string",
          "enum": [
            "block",
            "allow"
          ]
        },
        "har": {
          "type": "string"
        },
        "trace": {
          "default": false,
          "type": "boolean"
        },
        "rrweb": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "properties": {
        "strict": {
          "type": "boolean"
        },
        "masks": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maskConcealedInputs": {
          "default": false,
          "description": "Blur password fields and other inputs that already hide their value. Off by default. Each opted-in field is blurred on its own, only while it is on screen.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "deviceScaleFactor": {
          "default": 1,
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "compare": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "side-by-side",
            "onion",
            "wipe",
            "blink",
            "difference",
            "edge",
            "cropped-roi",
            "pixel-diff"
          ]
        },
        "streams": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "video",
              "dom",
              "pixel-diff"
            ]
          }
        },
        "viewports": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "deviceScaleFactor": {
                "default": 1,
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "blinkOptIn": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "mode",
    "profile",
    "surfaceCapture",
    "viewport"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
