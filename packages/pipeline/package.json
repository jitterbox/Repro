{
  "name": "@jitterbox/repro-pipeline",
  "version": "0.3.2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./commands/*": {
      "types": "./dist/commands/*.d.ts",
      "import": "./dist/commands/*.js",
      "default": "./dist/commands/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"for (const p of ['dist', 'tsconfig.build.tsbuildinfo']) require('node:fs').rmSync(p, { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@jitterbox/repro-core": "workspace:*",
    "@jitterbox/repro-contracts": "workspace:*",
    "@jitterbox/repro-capture": "workspace:*",
    "@jitterbox/repro-compare": "workspace:*",
    "@jitterbox/repro-plan": "workspace:*",
    "@jitterbox/repro-render": "workspace:*",
    "@jitterbox/repro-compositor": "workspace:*",
    "@jitterbox/repro-evaluation": "workspace:*",
    "@jitterbox/repro-alm": "workspace:*",
    "@jitterbox/repro-vault": "workspace:*",
    "@playwright/test": "1.62.0",
    "playwright": "1.62.0",
    "zod": "4.4.3",
    "@jitterbox/repro-viewer": "workspace:*",
    "esbuild": "0.28.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jitterbox/Repro.git",
    "directory": "packages/pipeline"
  },
  "homepage": "https://github.com/jitterbox/Repro#readme",
  "bugs": {
    "url": "https://github.com/jitterbox/Repro/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "@jitterbox/repro-pipeline \u2014 Repro browser evidence and annotated video pipeline"
}
