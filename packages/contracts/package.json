{
  "name": "@jitterbox/repro-contracts",
  "version": "0.3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens/overlay-theme.tokens.json": "./tokens/overlay-theme.tokens.json",
    "./schemas/*": "./schemas/*",
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./config-validator": {
      "types": "./dist/config-validator.d.ts",
      "import": "./dist/config-validator.js",
      "default": "./dist/config-validator.js"
    },
    "./plan": {
      "types": "./dist/plan.d.ts",
      "import": "./dist/plan.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "tokens"
  ],
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "prebuild": "pnpm run build:tokens",
    "build": "tsc -p tsconfig.build.json && node scripts/build-schemas.mjs",
    "generate:schemas": "tsc -p tsconfig.build.json && node scripts/build-schemas.mjs --write-source",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm run build:tokens"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jitterbox/Repro.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/jitterbox/Repro#readme",
  "bugs": {
    "url": "https://github.com/jitterbox/Repro/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "@jitterbox/repro-contracts \u2014 Repro browser evidence and annotated video pipeline"
}
