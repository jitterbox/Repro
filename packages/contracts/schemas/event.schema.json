{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repro.dev/schemas/event.schema.json",
  "title": "ReproEvent",
  "description": "Aligned with @repro/core EventRecordSchema (t_mono, kind).",
  "type": "object",
  "required": [
    "id",
    "seq",
    "schemaVersion",
    "runId",
    "pageId",
    "t_mono",
    "kind",
    "payload",
    "hash"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 0 },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "pageId": { "type": "string", "minLength": 1 },
    "t_mono": { "type": "number", "minimum": 0 },
    "t_epoch": { "type": "number", "minimum": 0 },
    "kind": { "type": "string", "minLength": 1 },
    "payload": {},
    "prevHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
