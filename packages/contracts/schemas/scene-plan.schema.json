{
  "$id": "https://repro.dev/schemas/scene-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "renderer": {
      "type": "string",
      "const": "hyperframes"
    },
    "layout": {
      "default": {},
      "type": "object",
      "properties": {
        "overlayPanels": {
          "default": "as-needed",
          "type": "string",
          "enum": [
            "never",
            "as-needed"
          ]
        },
        "overlayCornerOrder": {
          "default": [
            "bottom-right",
            "bottom-left",
            "top-left",
            "top-right"
          ],
          "minItems": 4,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "bottom-right",
              "bottom-left",
              "top-left",
              "top-right"
            ]
          }
        },
        "retireSteps": {
          "default": true,
          "type": "boolean"
        },
        "minStepVisibleMs": {
          "default": 5000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 30000
        },
        "useHeaderSpace": {
          "default": true,
          "type": "boolean"
        },
        "protectedPadding": {
          "default": 12,
          "type": "number",
          "minimum": 8,
          "maximum": 48
        },
        "protectedRegions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "style": {
      "default": {},
      "type": "object",
      "properties": {
        "bodyFontSize": {
          "default": 18,
          "type": "number",
          "minimum": 12,
          "maximum": 32
        },
        "headingFontSize": {
          "default": 20,
          "type": "number",
          "minimum": 14,
          "maximum": 40
        },
        "titleFontSize": {
          "default": 28,
          "type": "number",
          "minimum": 18,
          "maximum": 48
        },
        "dataFontSize": {
          "default": 14,
          "type": "number",
          "minimum": 10,
          "maximum": 28
        },
        "lineHeight": {
          "default": 1.4,
          "type": "number",
          "minimum": 1.1,
          "maximum": 2
        },
        "cardWidth": {
          "default": 336,
          "type": "integer",
          "minimum": 280,
          "maximum": 640
        },
        "cardPadding": {
          "default": 12,
          "type": "integer",
          "minimum": 8,
          "maximum": 32
        },
        "cardRadius": {
          "default": 8,
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "cardGap": {
          "default": 16,
          "type": "number",
          "minimum": 8,
          "maximum": 64
        },
        "outerInset": {
          "default": 24,
          "type": "integer",
          "minimum": 16,
          "maximum": 80
        },
        "gutterGap": {
          "default": 24,
          "type": "integer",
          "minimum": 16,
          "maximum": 96
        },
        "sourceTop": {
          "default": 96,
          "type": "integer",
          "minimum": 80,
          "maximum": 240
        },
        "mobileSourceTop": {
          "default": 128,
          "type": "integer",
          "minimum": 112,
          "maximum": 280
        },
        "minHeight": {
          "default": 960,
          "type": "integer",
          "minimum": 720,
          "maximum": 2160
        },
        "background": {
          "default": "#101721",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "cardBackground": {
          "default": "#1c2734",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "foreground": {
          "default": "#edf3f8",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "criticalAccent": {
          "default": "#f0b86c",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "criticalBackground": {
          "default": "#30251e",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "cursorColor": {
          "default": "#66d4e5",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "additionalProperties": false
    },
    "timing": {
      "default": {},
      "type": "object",
      "properties": {
        "entryMs": {
          "default": 150,
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "exitMs": {
          "default": 200,
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "readingHoldMs": {
          "default": 5400,
          "type": "integer",
          "minimum": 4000,
          "maximum": 30000
        },
        "outcomeHoldMs": {
          "default": 2200,
          "type": "integer",
          "minimum": 1000,
          "maximum": 15000
        },
        "clickWaveMs": {
          "default": 350,
          "type": "integer",
          "minimum": 200,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    },
    "encoding": {
      "default": {},
      "type": "object",
      "properties": {
        "crf": {
          "default": 18,
          "type": "integer",
          "minimum": 0,
          "maximum": 35
        },
        "preset": {
          "default": "veryfast",
          "type": "string",
          "enum": [
            "ultrafast",
            "superfast",
            "veryfast",
            "faster",
            "fast",
            "medium",
            "slow",
            "slower",
            "veryslow"
          ]
        }
      },
      "additionalProperties": false
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fps": {
          "type": "number",
          "const": 30
        }
      },
      "required": [
        "width",
        "height",
        "fps"
      ],
      "additionalProperties": false
    },
    "outputScale": {
      "default": 1,
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "actionAudio": {
      "default": false,
      "type": "boolean"
    },
    "cursorGlow": {
      "default": true,
      "type": "boolean"
    },
    "privacyMasks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "additionalProperties": false
      }
    },
    "cursorSamples": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "timeMs": {
            "type": "number",
            "minimum": 0
          },
          "pageId": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "type": "string"
          }
        },
        "required": [
          "x",
          "y",
          "timeMs",
          "pageId",
          "phase"
        ],
        "additionalProperties": false
      }
    },
    "sourceOrigin": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "segments": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "play",
              "hold",
              "insert"
            ]
          },
          "outStartMs": {
            "type": "number",
            "minimum": 0
          },
          "outDurationMs": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "sourceStartMs": {
            "type": "number",
            "minimum": 0
          },
          "rate": {
            "type": "number",
            "minimum": 0
          },
          "pageId": {
            "type": "string",
            "minLength": 1
          },
          "checkpoint": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "outStartMs",
          "outDurationMs",
          "rate"
        ],
        "additionalProperties": false
      }
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "title",
              "app-version",
              "step",
              "highlight",
              "magnifier",
              "alignment",
              "data-panel",
              "outcome",
              "pointer",
              "marker",
              "callout"
            ]
          },
          "startMs": {
            "type": "number",
            "minimum": 0
          },
          "endMs": {
            "type": "number",
            "minimum": 0
          },
          "layer": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "default": "",
            "type": "string"
          },
          "severity": {
            "default": "normal",
            "type": "string",
            "enum": [
              "normal",
              "critical"
            ]
          },
          "expected": {
            "type": "string"
          },
          "observed": {
            "type": "string"
          },
          "format": {
            "default": "value",
            "type": "string",
            "enum": [
              "value",
              "object",
              "events",
              "sparkline"
            ]
          },
          "unit": {
            "default": "",
            "type": "string"
          },
          "evidenceRefs": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "target": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "reference": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "placement": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "step": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "magnification": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "axis": {
            "type": "string",
            "enum": [
              "x",
              "y"
            ]
          },
          "dotted": {
            "default": false,
            "type": "boolean"
          },
          "points": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "timeMs": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "x",
                "y",
                "timeMs"
              ],
              "additionalProperties": false
            }
          },
          "action": {
            "type": "string",
            "enum": [
              "click",
              "double-click",
              "right-click",
              "hold",
              "drag",
              "cancel"
            ]
          },
          "samples": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "timeMs": {
                  "type": "number",
                  "minimum": 0
                },
                "text": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                }
              },
              "required": [
                "timeMs",
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "kind",
          "startMs",
          "endMs",
          "layer",
          "title"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "renderer",
    "viewport",
    "output",
    "sourceOrigin",
    "segments",
    "cues"
  ],
  "additionalProperties": false
}
