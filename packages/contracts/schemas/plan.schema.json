{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repro.dev/schemas/plan.schema.json",
  "title": "ReproPlan",
  "type": "object",
  "required": ["schemaVersion", "runId", "annotations"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "mode": {
      "type": "string",
      "enum": ["repro", "compare", "demo"]
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "https://repro.dev/schemas/annotation.schema.json"
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "startMono"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "startMono": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "redactionRects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pageId", "bbox", "startMono", "endMono"],
        "properties": {
          "pageId": { "type": "string" },
          "bbox": {
            "type": "object",
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number", "minimum": 0 },
              "height": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "startMono": { "type": "number", "minimum": 0 },
          "endMono": { "type": "number", "minimum": 0 },
          "ruleId": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "plannerVersion": { "type": "string" },
        "modelId": { "type": "string" },
        "promptDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
