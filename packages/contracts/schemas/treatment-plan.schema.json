{
  "$id": "https://repro.dev/schemas/treatment-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "layout": {
      "default": {},
      "type": "object",
      "properties": {
        "overlayPanels": {
          "default": "as-needed",
          "type": "string",
          "enum": [
            "never",
            "as-needed"
          ]
        },
        "overlayCornerOrder": {
          "default": [
            "bottom-right",
            "bottom-left",
            "top-left",
            "top-right"
          ],
          "minItems": 4,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "bottom-right",
              "bottom-left",
              "top-left",
              "top-right"
            ]
          }
        },
        "retireSteps": {
          "default": true,
          "type": "boolean"
        },
        "minStepVisibleMs": {
          "default": 5000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 30000
        },
        "useHeaderSpace": {
          "default": true,
          "type": "boolean"
        },
        "protectedPadding": {
          "default": 12,
          "type": "number",
          "minimum": 8,
          "maximum": 48
        },
        "protectedRegions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "style": {
      "default": {},
      "type": "object",
      "properties": {
        "bodyFontSize": {
          "default": 18,
          "type": "number",
          "minimum": 12,
          "maximum": 32
        },
        "headingFontSize": {
          "default": 20,
          "type": "number",
          "minimum": 14,
          "maximum": 40
        },
        "titleFontSize": {
          "default": 28,
          "type": "number",
          "minimum": 18,
          "maximum": 48
        },
        "dataFontSize": {
          "default": 14,
          "type": "number",
          "minimum": 10,
          "maximum": 28
        },
        "lineHeight": {
          "default": 1.4,
          "type": "number",
          "minimum": 1.1,
          "maximum": 2
        },
        "cardWidth": {
          "default": 336,
          "type": "integer",
          "minimum": 280,
          "maximum": 640
        },
        "cardPadding": {
          "default": 12,
          "type": "integer",
          "minimum": 8,
          "maximum": 32
        },
        "cardRadius": {
          "default": 8,
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "cardGap": {
          "default": 16,
          "type": "number",
          "minimum": 8,
          "maximum": 64
        },
        "outerInset": {
          "default": 24,
          "type": "integer",
          "minimum": 16,
          "maximum": 80
        },
        "gutterGap": {
          "default": 24,
          "type": "integer",
          "minimum": 16,
          "maximum": 96
        },
        "sourceTop": {
          "default": 96,
          "type": "integer",
          "minimum": 80,
          "maximum": 240
        },
        "mobileSourceTop": {
          "default": 128,
          "type": "integer",
          "minimum": 112,
          "maximum": 280
        },
        "minHeight": {
          "default": 960,
          "type": "integer",
          "minimum": 720,
          "maximum": 2160
        },
        "background": {
          "default": "#101721",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "cardBackground": {
          "default": "#1c2734",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "foreground": {
          "default": "#edf3f8",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "criticalAccent": {
          "default": "#f0b86c",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "criticalBackground": {
          "default": "#30251e",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "cursorColor": {
          "default": "#66d4e5",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "additionalProperties": false
    },
    "timing": {
      "default": {},
      "type": "object",
      "properties": {
        "entryMs": {
          "default": 150,
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "exitMs": {
          "default": 200,
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "readingHoldMs": {
          "default": 5400,
          "type": "integer",
          "minimum": 4000,
          "maximum": 30000
        },
        "outcomeHoldMs": {
          "default": 2200,
          "type": "integer",
          "minimum": 1000,
          "maximum": 15000
        },
        "clickWaveMs": {
          "default": 350,
          "type": "integer",
          "minimum": 200,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    },
    "encoding": {
      "default": {},
      "type": "object",
      "properties": {
        "crf": {
          "default": 18,
          "type": "integer",
          "minimum": 0,
          "maximum": 35
        },
        "preset": {
          "default": "veryfast",
          "type": "string",
          "enum": [
            "ultrafast",
            "superfast",
            "veryfast",
            "faster",
            "fast",
            "medium",
            "slow",
            "slower",
            "veryslow"
          ]
        }
      },
      "additionalProperties": false
    },
    "treatments": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "highlight",
              "magnifier",
              "alignment",
              "slowmo",
              "data-panel",
              "callout"
            ]
          },
          "checkpoint": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "segment": {
            "type": "string",
            "minLength": 1
          },
          "eventKind": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "default": "",
            "type": "string"
          },
          "severity": {
            "default": "normal",
            "type": "string",
            "enum": [
              "normal",
              "critical"
            ]
          },
          "expected": {
            "type": "string"
          },
          "stateKey": {
            "type": "string",
            "minLength": 1
          },
          "eventMatch": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "valuePath": {
            "type": "string"
          },
          "format": {
            "default": "value",
            "type": "string",
            "enum": [
              "value",
              "object",
              "events",
              "sparkline"
            ]
          },
          "unit": {
            "default": "",
            "type": "string"
          },
          "dotted": {
            "default": false,
            "type": "boolean"
          },
          "required": {
            "default": true,
            "type": "boolean"
          },
          "magnification": {
            "default": 2,
            "anyOf": [
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 4
              }
            ]
          },
          "rate": {
            "default": 0.2,
            "anyOf": [
              {
                "type": "number",
                "const": 0.1
              },
              {
                "type": "number",
                "const": 0.2
              }
            ]
          },
          "axis": {
            "default": "x",
            "type": "string",
            "enum": [
              "x",
              "y"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "sequence": {
            "default": "main",
            "type": "string",
            "minLength": 1
          },
          "numbered": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "step"
        ],
        "additionalProperties": false
      }
    },
    "outputScale": {
      "default": 1,
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "actionAudio": {
      "default": false,
      "type": "boolean"
    },
    "cursorGlow": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": false
}
