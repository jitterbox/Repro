{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repro.dev/schemas/annotation.schema.json",
  "title": "ReproAnnotation",
  "type": "object",
  "required": ["id", "kind", "severity", "timeRange", "label"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "callout",
        "highlight",
        "cursor",
        "keystroke",
        "console",
        "step",
        "chapter",
        "redaction",
        "diff",
        "freeze",
        "spec"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warn", "critical"]
    },
    "timeRange": {
      "type": "object",
      "required": ["startMono", "endMono"],
      "properties": {
        "startMono": { "type": "number", "minimum": 0 },
        "endMono": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "selector": { "type": "string" },
        "pageId": { "type": "string" },
        "bbox": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "evidenceRef": { "type": "string" }
      },
      "additionalProperties": false
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "shape": {
      "type": "string",
      "enum": ["rect", "ellipse", "arrow", "line", "badge", "none"]
    },
    "icon": {
      "type": "string"
    },
    "lineStyle": {
      "type": "string",
      "enum": ["solid", "dashed", "dotted"]
    },
    "placement": {
      "type": "string",
      "enum": [
        "auto",
        "top",
        "bottom",
        "left",
        "right",
        "center",
        "leader"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0
    },
    "collisionPolicy": {
      "type": "string",
      "enum": ["avoid", "overlap", "truncate"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reviewState": {
      "type": "string",
      "enum": ["open", "resolved", "dismissed", "verified"]
    }
  },
  "additionalProperties": false
}
