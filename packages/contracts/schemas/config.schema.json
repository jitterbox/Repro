{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repro.dev/schemas/config.schema.json",
  "title": "ReproConfig",
  "description": "Aligned with @repro/core ReproConfigSchema (profile, not executionProfile).",
  "type": "object",
  "required": ["mode", "profile", "surfaceCapture", "viewport"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["repro", "compare", "demo"]
    },
    "features": {
      "type": "object",
      "properties": {
        "cursor": { "type": "boolean" },
        "keystrokes": { "type": "boolean" },
        "clickViz": { "type": "boolean" },
        "consoleOverlay": { "type": "boolean" },
        "specCard": { "type": "boolean" },
        "steps": { "type": "boolean" },
        "pauses": { "type": "boolean" },
        "slowmo": { "type": "boolean" },
        "zoom": { "type": "boolean" },
        "redaction": { "type": "boolean" },
        "vitalsHud": { "type": "boolean" },
        "voiceover": { "type": "boolean" },
        "freezeDetect": { "type": "boolean" },
        "a11yOverlay": { "type": "boolean" },
        "hiddenElements": { "type": "boolean" },
        "hitTargets": { "type": "boolean" },
        "stackingContexts": { "type": "boolean" },
        "layoutShiftViz": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "string",
      "enum": ["faithful", "controlled"]
    },
    "surfaceCapture": {
      "type": "string",
      "enum": ["page", "os"]
    },
    "timingSensitive": { "type": "boolean" },
    "preserveRealTiming": { "type": "boolean" },
    "showActions": { "type": "boolean" },
    "capturePreviewUi": {
      "type": "boolean",
      "description": "When true, Playwright/probe presentation UI may burn into capture frames. Leave false for delivery captures."
    },
    "redaction": {
      "type": "object",
      "properties": {
        "strict": { "type": "boolean" },
        "masks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "viewport": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "deviceScaleFactor": { "type": "number", "minimum": 0.1 }
      },
      "additionalProperties": false
    },
    "compare": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "side-by-side",
            "onion",
            "wipe",
            "blink",
            "difference",
            "edge",
            "cropped-roi",
            "pixel-diff"
          ]
        },
        "streams": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["video", "dom", "pixel-diff"]
          }
        },
        "viewports": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
