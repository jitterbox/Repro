{
  "schemaVersion": "1.0.0",
  "id": "repro-evidence-light",
  "burnInFont": {
    "family": "DejaVu Sans",
    "mono": "DejaVu Sans Mono",
    "fallback": [
      "Arial",
      "Liberation Sans"
    ]
  },
  "viewport": {
    "width": 1280,
    "height": 720,
    "deviceScaleFactor": 1
  },
  "safeZones": {
    "inset": 24,
    "bottomBand": 96,
    "maxBottomBandOccupants": 1
  },
  "colors": {
    "repro-add": {
      "hex": "#1B7F4A",
      "role": "Element or state added"
    },
    "repro-remove": {
      "hex": "#C42020",
      "role": "Element or state removed"
    },
    "repro-change": {
      "hex": "#C47A00",
      "role": "Element changed or moved"
    },
    "repro-info": {
      "hex": "#2457D6",
      "role": "Neutral callout / step"
    },
    "repro-critical": {
      "hex": "#C42020",
      "role": "Console error, critical a11y"
    },
    "repro-warn": {
      "hex": "#996200",
      "role": "Warning / freeze / CLS"
    },
    "repro-click-left": {
      "hex": "#0B8FAD",
      "role": "Primary click ripple"
    },
    "repro-click-right": {
      "hex": "#B13D8C",
      "role": "Context-click ripple"
    },
    "repro-label-fg": {
      "hex": "#FFFFFF",
      "role": "Text on dark label fill"
    },
    "repro-label-bg": {
      "hex": "#202020E6",
      "role": "Label plate, ~90% opaque"
    },
    "repro-slate-bg": {
      "hex": "#101319",
      "role": "Opening slate ground"
    },
    "repro-before": {
      "hex": "#5B6B8C",
      "role": "Compare Before / Broken"
    },
    "repro-after": {
      "hex": "#1B7F4A",
      "role": "Compare After / Fixed"
    },
    "repro-ring-halo": {
      "hex": "#FFFFFFE6",
      "role": "ADDED: 1px outer ring under every stroke"
    },
    "repro-plate-hairline": {
      "hex": "#FFFFFF2E",
      "role": "ADDED: plate edge, separates stacked plates"
    },
    "repro-meta": {
      "hex": "#B8BFCC",
      "role": "ADDED: slate + HUD secondary text"
    },
    "repro-scrim": {
      "hex": "#10131980",
      "role": "ADDED: full-frame dim behind slate and outcome cards only"
    },
    "repro-progress": {
      "hex": "#FFFFFFBF",
      "role": "ADDED: 4px bottom progress rail"
    }
  },
  "severityMap": {
    "info": "repro-info",
    "low": "repro-info",
    "medium": "repro-warn",
    "warn": "repro-warn",
    "high": "repro-critical",
    "critical": "repro-critical"
  },
  "type": {
    "slateTitle": {
      "size": 32,
      "weight": 600,
      "lineHeight": 1.15
    },
    "slateMeta": {
      "size": 15,
      "weight": 400,
      "color": "repro-meta"
    },
    "calloutLabel": {
      "size": 17,
      "weight": 500,
      "maxChars": 42
    },
    "calloutKicker": {
      "size": 11,
      "weight": 700,
      "tracking": 0.13
    },
    "badge": {
      "size": 14,
      "weight": 700,
      "tracking": 0.06,
      "tabular": true
    },
    "console": {
      "size": 14,
      "mono": true,
      "singleLine": true
    },
    "geometryCaption": {
      "size": 14,
      "tabular": true
    }
  },
  "motion": {
    "slateToContent": {
      "kind": "dissolve",
      "ms": 320
    },
    "plateIn": {
      "kind": "fade+scale",
      "ms": 150,
      "from": 0.96
    },
    "plateOut": {
      "kind": "fade",
      "ms": 250
    },
    "clickRipple": {
      "kind": "expand+fade",
      "ms": 350,
      "maxPerSecond": 3
    },
    "toastIn": {
      "kind": "slide+fade",
      "ms": 200
    },
    "toastOut": {
      "kind": "fade",
      "ms": 400
    },
    "triggerHighlight": {
      "assFade": [
        200,
        400
      ]
    },
    "maxFlashHz": 2
  },
  "holdsMs": {
    "slate": {
      "min": 2000,
      "typical": 2200
    },
    "chapter": {
      "min": 1600,
      "typical": 2000,
      "perWord": 220
    },
    "callout": {
      "min": 1400,
      "typical": 2000,
      "perChar": 45
    },
    "consoleToast": {
      "min": 2200,
      "typical": 2600
    },
    "pause": {
      "min": 1000,
      "typical": 1400
    },
    "slowmo": {
      "min": 1200,
      "typical": 1600
    },
    "outcome": {
      "min": 2500,
      "typical": 2500
    },
    "compareBeat": {
      "min": 3000,
      "typical": 4000
    }
  },
  "duration": {
    "filedReproMinMs": 15000,
    "filedReproMaxMs": 30000,
    "hardMinMs": 8000,
    "hardMaxMs": 45000
  }
}
