{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$version": "2025.10",
  "color": {
    "surface": {
      "canvas": { "$type": "color", "$value": "#ffffff" },
      "panel": { "$type": "color", "$value": "#f7f8fb" },
      "inverse": { "$type": "color", "$value": "#101319" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#101319" },
      "muted": { "$type": "color", "$value": "#5f6673" },
      "inverse": { "$type": "color", "$value": "#ffffff" }
    },
    "emphasis": {
      "primary": { "$type": "color", "$value": "#2457d6" },
      "accent": { "$type": "color", "$value": "#7a3df0" }
    },
    "severity": {
      "info": { "$type": "color", "$value": "#2457d6" },
      "warning": { "$type": "color", "$value": "#996200" },
      "critical": { "$type": "color", "$value": "#c42020" }
    },
    "focus": {
      "ring": { "$type": "color", "$value": "#005fcc" }
    },
    "safe": {
      "background": { "$type": "color", "$value": "#eaf7ef" },
      "text": { "$type": "color", "$value": "#176b35" }
    },
    "redacted": {
      "background": { "$type": "color", "$value": "#171717" },
      "text": { "$type": "color", "$value": "#ffffff" }
    }
  },
  "typography": {
    "family": { "$type": "fontFamily", "$value": "system-ui, sans-serif" },
    "body": { "$type": "fontSize", "$value": "1rem" },
    "small": { "$type": "fontSize", "$value": "0.875rem" },
    "heading": { "$type": "fontSize", "$value": "1.25rem" }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": "0.25rem" },
    "sm": { "$type": "dimension", "$value": "0.5rem" },
    "md": { "$type": "dimension", "$value": "1rem" },
    "lg": { "$type": "dimension", "$value": "1.5rem" }
  },
  "motion": {
    "duration": { "$type": "duration", "$value": "160ms" },
    "easing": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "annotation": {
    "stroke": {
      "solid": { "$type": "strokeStyle", "$value": "solid" },
      "dashed": { "$type": "strokeStyle", "$value": "dashed" },
      "dotted": { "$type": "strokeStyle", "$value": "dotted" }
    },
    "shape": {
      "rect": { "$type": "string", "$value": "rectangle" },
      "ellipse": { "$type": "string", "$value": "ellipse" },
      "underline": { "$type": "string", "$value": "underline" }
    }
  }
}
