{
  "schemaVersion": "1.0.0",
  "id": "webdash-settings-panel",
  "title": "Web-Dash: inspect application settings",
  "variant": {
    "id": "walkthrough",
    "role": "standalone",
    "label": "Recorded live application"
  },
  "claim": "The real Settings sheet exposes the Theme controls above Sales.",
  "expected": "The real Settings sheet exposes the Theme controls above Sales.",
  "targets": [
    {
      "id": "detail",
      "description": "Theme controls"
    }
  ],
  "steps": [
    {
      "id": "prepare",
      "title": "Open the authenticated dashboard"
    },
    {
      "id": "menu",
      "title": "Open navigation"
    },
    {
      "id": "destination",
      "title": "Open Sales"
    },
    {
      "id": "inspect",
      "title": "Open Settings",
      "trigger": true
    },
    {
      "id": "verify",
      "title": "Observe the recorded result"
    }
  ],
  "checkpoints": [
    {
      "id": "result",
      "step": "verify",
      "title": "Observed application state",
      "targets": ["detail"],
      "observations": ["screenshot", "bounds", "assertion"]
    }
  ],
  "outputs": ["png", "mp4", "review", "package"],
  "presentation": {
    "readingHoldMs": 5400
  },
  "privacy": {
    "strict": true,
    "selectors": [],
    "patterns": []
  }
}
