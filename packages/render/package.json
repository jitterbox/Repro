{
  "name": "@jitterbox/repro-render",
  "version": "0.3.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"for (const p of ['dist', 'tsconfig.build.tsbuildinfo']) require('node:fs').rmSync(p, { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@jitterbox/repro-contracts": "workspace:*",
    "@jitterbox/repro-core": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jitterbox/Repro.git",
    "directory": "packages/render"
  },
  "homepage": "https://github.com/jitterbox/Repro#readme",
  "bugs": {
    "url": "https://github.com/jitterbox/Repro/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Shared source sanitization, media inspection and strict privacy auditing for Repro"
}
