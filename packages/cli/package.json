{
  "name": "@repro/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "repro": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@repro/alm": "workspace:*",
    "@repro/capture": "workspace:*",
    "@repro/compare": "workspace:*",
    "@repro/compositor": "workspace:*",
    "@repro/contracts": "workspace:*",
    "@repro/core": "workspace:*",
    "@repro/evaluation": "workspace:*",
    "@repro/plan": "workspace:*",
    "@repro/render": "workspace:*",
    "@repro/vault": "workspace:*",
    "commander": "^13.1.0",
    "zod": "^4.4.3"
  }
}
