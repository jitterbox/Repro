{
  "name": "@jitterbox/repro-cli",
  "version": "0.3.0",
  "type": "module",
  "bin": {
    "repro": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "assets/branding/repro-logo.png"
  ],
  "scripts": {
    "build": "node -e \"for (const p of ['dist', 'tsconfig.build.tsbuildinfo']) require('node:fs').rmSync(p, { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "zod": "4.4.3",
    "@jitterbox/repro-pipeline": "workspace:*",
    "@jitterbox/repro-contracts": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jitterbox/Repro.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/jitterbox/Repro#readme",
  "bugs": {
    "url": "https://github.com/jitterbox/Repro/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "@jitterbox/repro-cli \u2014 Repro browser evidence and annotated video pipeline"
}
